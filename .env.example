# 复制为 .env.local 后填入真实值。.env.local 已被 .gitignore 忽略。

# ---- 火山方舟（豆包）：chat 与生图 ----
# https://console.volcengine.com/ark  →  API Key
# ModelGateway 是本仓库唯一的外部模型端口，所有调用经它。
#
# 模型 ID 全部经过实测（GET /models + 真实调用），不要照文档或博客抄：
# 账号里大量模型处于 Shutdown / Retiring / 未开通状态，抄一个上去就是 404。
# 已验证不可用：doubao-seed-1-8、doubao-seed-1-6-lite、doubao-1-5-lite-32k
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 便宜档（默认，日常主力）约 ¥0.3/M
ARK_CHAT_MODEL=doubao-seed-2-0-mini-260428
# 贵档（需显式要求 tier: 'strong'）约 ¥0.6/M
ARK_CHAT_MODEL_STRONG=doubao-seed-2-0-lite-260428
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828

# ---- 本地 Ollama：embedding ----
# 见 docs/adr/0001-embedding-model-and-dimension.md
# 方舟的 embedding 模型本账号全部未开通且处于 Retiring，故走本地推理。
# 维度写死在 pgvector 列定义里，改这里必须同步改 migration 并重算全部存量向量。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=paraphrase-multilingual
EMBED_DIMENSIONS=768

# ---- Supabase 本地（supabase start 后由 CLI 打印）----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- 测试 ----
# 模型响应录制回放。测试要稳定，但不能失真 —— 所以不手写假响应，
# 而是录下真实模型输出后重放。
#   record = 打真实模型并落盘（本地跑，需要 key）
#   replay = 只读盘，缺条目直接抛错（CI 默认，不会偷偷联网）
#   live   = 每次都打真实模型
MODEL_CASSETTE_MODE=replay
MODEL_CASSETTE_DIR=test/cassettes
