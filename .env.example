# 复制为 .env.local 后填入真实值。.env.local 已被 .gitignore 忽略。

# ---- 火山方舟（豆包）----
# https://console.volcengine.com/ark  →  API Key
# ModelGateway 是本仓库唯一的外部模型端口，所有 LLM / embedding / 生图调用经它。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-1-8
ARK_EMBEDDING_MODEL=doubao-embedding-large-text-250515
ARK_IMAGE_MODEL=doubao-seedream-4-0-250828

# ---- Supabase 本地（supabase start 后由 CLI 打印）----
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- 测试 ----
# cassette 录制模式：record = 打真实模型并落盘；replay = 只读盘（CI 默认）
MODEL_CASSETTE_MODE=replay
